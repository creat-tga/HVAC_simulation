# Backend environment variables
# Copy this file to .env and modify as needed

# Database (SQLite default, switch to PostgreSQL for production)
# SQLite:  sqlite+aiosqlite:///./hvac_simulation.db
# PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/hvac_simulation
DATABASE_URL=sqlite+aiosqlite:///./hvac_simulation.db

# CORS origins (comma-separated)
CORS_ORIGINS=["http://localhost:5173"]

# EnergyPlus installation path
ENERGYPLUS_PATH=

# Debug mode
DEBUG=true

# Equipment data sync — set to true to (re)seed the equipment library
# from JSON files under <repo_root>/data/equipment/ on each backend startup.
# Existing rows are upserted by (equipment_type, model_no); rows already in
# the DB but absent from the JSON are kept. Recommended workflow: enable once
# after editing the JSON files, then disable.
SEED_EQUIPMENT_FROM_DATA=false
# Optional absolute path override; leave empty to use <repo_root>/data/equipment
EQUIPMENT_DATA_DIR=

# Production security (required when DEBUG=false)
SECRET_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# multiSystem calculation service (configure its SERVER_PORT=8010)
MULTISYSTEM_BASE_URL=http://127.0.0.1:8010
MULTISYSTEM_TIMEOUT_SECONDS=60
MULTISYSTEM_POLL_INTERVAL_SECONDS=2
MULTISYSTEM_API_KEY=