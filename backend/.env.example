# Backend environment variables
# Copy this file to .env and modify as needed

# Database (SQLite default, switch to PostgreSQL for production)
# SQLite:  sqlite+aiosqlite:///./hvac_simulation.db
# PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/hvac_simulation
DATABASE_URL=sqlite+aiosqlite:///./hvac_simulation.db

# CORS origins (comma-separated)
CORS_ORIGINS=["http://localhost:5173"]

# EnergyPlus installation path
ENERGYPLUS_PATH=

# Debug mode
DEBUG=true
